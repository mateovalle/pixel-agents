// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:electron",
			"type": "npm",
			"script": "build:electron",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"label": "dev:vite",
			"type": "npm",
			"script": "dev:vite",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Local:.*http://localhost"
				}
			},
			"presentation": {
				"group": "dev",
				"reveal": "never"
			}
		},
		{
			"label": "check",
			"type": "npm",
			"script": "check",
			"problemMatcher": ["$tsc", "$eslint-stylish"],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}
