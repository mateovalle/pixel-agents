{
  "name": "pixel-agents-desktop",
  "version": "1.0.0",
  "description": "Pixel Agents — standalone desktop app for visualizing AI coding agents",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cd webview-ui && npx vite --port 5173",
    "dev:electron": "npm run build:electron && VITE_DEV_SERVER_URL=http://localhost:5173 npx electron dist-electron/main.js",
    "build:electron": "cd electron && npx tsc",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:electron && npm run build:webview",
    "start": "npm run build && npx electron dist-electron/main.js",
    "package": "npm run build && npx electron-builder"
  },
  "build": {
    "appId": "com.pixelagents.desktop",
    "productName": "Pixel Agents",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/webview/**/*"
    ],
    "extraResources": [
      {
        "from": "webview-ui/public/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
